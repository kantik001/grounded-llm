# =============================================================================
# Grounded LLM — environment template (copy to .env)
# cp .env.example .env
# =============================================================================

SERVER_PORT=8080

# Environment mode: development | production
# production enables fail-fast checks (secrets required, no mock auth)
GROUNDED_ENV=development

# Python RAG service (in Docker use service name "python")
PYTHON_RAG_URL=http://python:5000/rag/context
PYTHON_BASE_URL=http://python:5000
PYTHON_SERVICE_PORT=5000
# Optional: CORS for Python (leave empty — internal service; do not use * in production)
# PYTHON_CORS_ORIGINS=
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120

# LLM (OpenAI-compatible API)
# LLM_PROVIDER: openai (default / OpenRouter) | ollama | vllm
LLM_PROVIDER=openai
LLM_API_KEY=
# Leave empty to auto-resolve from LLM_PROVIDER (openai→OpenRouter, ollama→http://ollama:11434, vllm→http://vllm:8000)
LLM_BASE_URL=
LLM_MODEL=openrouter/free
# OLLAMA_MODEL=llama3.2
# VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# vLLM profile (docker compose --profile vllm)
# HUGGING_FACE_HUB_TOKEN=
# VLLM_MAX_MODEL_LEN=4096
# VLLM_GPU_MEMORY_UTILIZATION=0.90

# Redis (embedding cache + semantic LLM response cache + distributed rate limit)
REDIS_URL=redis://redis:6379/0
# EMBEDDING_CACHE_TTL_SEC=3600
# LLM_RESPONSE_CACHE_TTL_SEC=86400

# Telegram Web App
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_DISABLED=false
TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400

# Empty list = same-origin only (no cross-origin callers); "*" reflects any
# origin without credentials and is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Applies per authenticated actor; unauthenticated endpoints (signup, checkout)
# are limited per client IP. When REDIS_URL is set, the limiter is shared across
# server replicas (ZSET sliding window); otherwise in-process only.
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Bearer token for GET /metrics. Required in production (endpoint returns 403
# there when unset); optional in development.
# METRICS_TOKEN=

# Dev defaults only — change for production (see docker-compose.prod.yml)
POSTGRES_PASSWORD=grounded
DATABASE_URL=postgres://grounded:grounded@postgres:5432/grounded?sslmode=disable
# PG_POOL_MAX_CONNS=20
# PG_POOL_MIN_CONNS=0
# PG_POOL_MAX_CONN_LIFETIME_SEC=3600
# PG_POOL_MAX_CONN_IDLE_SEC=300
UPLOAD_DIR=/data/uploads
DATA_DIR=/app/data

# JSON configs (optional)
# DOMAINS_CONFIG_PATH=config/domains.json
# LOCALES_ROOT=config/locales
DEFAULT_LOCALE=en
# CONFIG_RELOAD_INTERVAL_SEC=0

FORCE_RAG_REINDEX=false

# Vector store (Python RAG) — see docs/en/VECTOR_STORE.md
# VECTOR_STORE=chroma
# CHROMA_PERSIST_DIR=./chroma_db
# VECTOR_STORE=qdrant
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=grounded_llm
# VECTOR_STORE=pgvector
# PGVECTOR_URL=postgres://grounded:grounded@postgres:5432/grounded?sslmode=disable
# PGVECTOR_COLLECTION=grounded_chunks
# RAG_RETRIEVAL_MODE=hybrid   # vector | hybrid (BM25 + dense + RRF); compose defaults to hybrid
# RAG_RRF_K=60                # RRF constant (default 60)
# SPARSE_INDEX_DIR=./sparse_index
# Second stage rerank; compose defaults to keyword.
# RAG_RERANKER=keyword        # none | keyword | cross_encoder
# RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# E5 "query:"/"passage:" prefixes for dense retrieval — auto-on for e5 models.
# Flipping this changes the embedding space; the index is rebuilt automatically.
# RAG_E5_PREFIXES=1

# Knowledge-base root shared by the Go server (uploads) and Python indexing.
# Compose/Helm set this to the mounted volume; local default is ./data.
# DATA_DIR=./data

# Answer faithfulness check on top of numeric verify (Spec v2):
# off | warn (log unsupported sentences, default) | enforce (fail verification)
# VERIFY_FAITHFULNESS=warn
# VERIFY_FAITHFULNESS_MIN_SUPPORT=0.5   # min fraction of supported stems per sentence

# Optional ranking gates for scripts/run_rag_eval.py (cases with expect_sources/expect_chunks)
# EVAL_MIN_RECALL=0.8
# EVAL_MIN_NDCG=0.7

ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional operator files: copy from config/examples/*.json.example → config/*.json
# ADMIN_USERS_FILE=config/admin_users.json
# TENANT_QUOTAS_FILE=config/tenant_quotas.json

# OIDC SSO for admin UI (optional — see config/SSO.md)
# OIDC_ENABLED=true
# OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://your-host/api/admin/auth/callback
# OIDC_SESSION_SECRET=
# OIDC_ROLE_MAPPING_FILE=config/oidc_role_mapping.json
# OIDC_SESSION_TTL_HOURS=12

# External API + multi-tenant
# Format: key[:label[:tenant]]. Each key is bound to one tenant (empty =
# DEFAULT_TENANT_ID; "*" = any allowlisted tenant, for trusted gateways only).
# Keys may be pre-hashed as sha256:<hex> (sha256 of the raw key); plaintext
# values are hashed at load and never kept in process memory.
# API_KEYS=key1:label1:acme,sha256:ab12...:ci-key:*
# API_KEYS_FILE=config/api_keys.json   # entries: {"key","label","roles","tenant"}
DEFAULT_TENANT_ID=default
# ALLOWED_TENANTS=default,acme

# CI / smoke only — deterministic RAG+LLM without external services (never in production)
# LLM_MOCK=true
# RAG_MOCK=true

# Internal auth between Go server and Python RAG (required when GROUNDED_ENV=production)
# RAG_SERVICE_TOKEN=

# grounded-guardrails verify (optional — https://github.com/kantik001/grounded-guardrails)
# GUARDRAILS_MODE=local          # local (default) | remote | hybrid
# GUARDRAILS_GRPC_ADDR=localhost:50052
# GUARDRAILS_PII_BLOCK=false
# Compose: docker compose -f docker-compose.yml -f docker-compose.guardrails.yml up -d --build

# Data retention (0 = disabled). Purge runs every RETENTION_INTERVAL_HOURS.
# MESSAGE_RETENTION_DAYS=90
# SESSION_RETENTION_DAYS=365
# RETENTION_INTERVAL_HOURS=24

# SharePoint Graph connector (optional — see docs/en/CONNECTORS.md)
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_DRIVE_ID=
# SHAREPOINT_FOLDER_PATH=

# Google Drive API connector (optional — pip install -r connectors/requirements.txt)
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_IMPERSONATE_USER=

# Confluence REST connector (optional)
# CONFLUENCE_BASE_URL=https://your.atlassian.net/wiki
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE_KEY=

# Hosted SaaS signup + Stripe billing (Phase 10–11 — optional)
# SAAS_SIGNUP_ENABLED=false
# Tenants/quotas persist to Postgres by default when DATABASE_URL is live
# (tables saas_tenants, tenant_quotas). JSON files remain as optional dual-write
# / seed. Set TENANTS_STORE=file to force JSON-only (single-replica demos).
# TENANTS_STORE=postgres
# TENANTS_REGISTRY_FILE=config/tenants.json
# TENANT_QUOTAS_FILE=config/tenant_quotas.json
# Admin users: Postgres admin_users table + optional ADMIN_USERS_FILE dual-write.
# ADMIN_USERS_STORE=postgres
# ADMIN_USERS_FILE=config/admin_users.json
# Telegram tenant membership (off by default for backward compatibility):
# TENANT_MEMBERSHIP_ENFORCE=true
# TENANT_MEMBERSHIP_AUTO_DEFAULT=true   # grant default tenant on first login
# PLANS_FILE=config/plans.yaml
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost/signup.html?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost/signup.html?checkout=cancel

# Optional NLI sidecar for faithfulness (HTTP JSON: premise/hypothesis → entailed/label)
# VERIFY_NLI=assist          # off | assist | replace
# VERIFY_NLI_URL=http://127.0.0.1:8090/score

# OpenTelemetry (OTLP HTTP). Empty = log-only PathTrace.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=grounded-llm-server
