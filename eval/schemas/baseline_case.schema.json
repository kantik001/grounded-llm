{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kantik001/grounded-llm/eval/schemas/baseline_case.schema.json",
  "title": "Grounded RAG retrieval eval case",
  "type": "object",
  "required": ["domain_id", "question"],
  "additionalProperties": false,
  "properties": {
    "domain_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "question": { "type": "string", "minLength": 3 },
    "category": { "type": "string" },
    "adversarial_type": {
      "type": "string",
      "enum": [
        "wrong_number",
        "missing_citation",
        "cross_domain",
        "prompt_injection",
        "pii_trap"
      ]
    },
    "expect_contains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "expect_not_contains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "expect_context": { "type": "boolean" },
    "expect_out_of_scope": { "type": "boolean" }
  },
  "anyOf": [
    {
      "required": ["expect_out_of_scope"],
      "properties": { "expect_out_of_scope": { "const": true } }
    },
    {
      "required": ["expect_contains"],
      "properties": {
        "expect_contains": { "type": "array", "minItems": 1 }
      }
    },
    { "required": ["expect_not_contains"] }
  ]
}
