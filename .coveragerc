[run]
branch = False
source = rag
omit =
    rag/vector_backend/qdrant_backend.py
    rag/vector_backend/pgvector_backend.py
    rag/vector_backend/chroma_backend.py
    # Embedding/disk cache and live vector stores need integration harnesses.
    rag/embedding_cache.py
    # Async ingest needs Postgres + Redis integration harness (see tests/test_ingest_*.py).
    rag/ingest/*
    # KB registry needs Postgres + blob store (see tests/test_kb_registry.py, scripts/backfill_kb_registry.py).
    rag/kb/documents.py
    rag/kb/index_runs.py
    rag/kb_discovery.py
    rag/storage/blob_store.py

[report]
fail_under = 70
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
