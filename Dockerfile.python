FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PYTHON_SERVICE_PORT=5000 \
    PYTHON_GRPC_PORT=50051 \
    GRPC_MAX_WORKERS=4 \
    GUNICORN_WORKERS=2 \
    GUNICORN_TIMEOUT=120

# tini as PID 1: reap zombies (gunicorn workers) and forward signals to CMD.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir 'grpcio-tools==1.69.0'

COPY api/ ./api/
COPY rag/ ./rag/
COPY scripts/ ./scripts/
COPY config/ ./config/
COPY data/ ./data/

# Same generator as local/CI so import paths stay consistent.
RUN python scripts/gen_retriever_grpc.py \
    && chmod +x /app/api/entrypoint.sh

# Non-root runtime user; runtime-writable dirs (index caches, uploads, HF cache).
RUN groupadd -g 10001 app \
    && useradd -m -u 10001 -g app app \
    && mkdir -p /app/chroma_db /app/sparse_index /app/data \
    && chown -R app:app /app

ENV HF_HOME=/home/app/.cache/huggingface

USER app

EXPOSE 5000 50051

ENTRYPOINT ["tini", "--"]
CMD ["/app/api/entrypoint.sh"]
