FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHON_SERVICE_PORT=5000 \
    PYTHON_GRPC_PORT=50051 \
    GUNICORN_WORKERS=2 \
    GUNICORN_TIMEOUT=120

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir 'grpcio-tools>=1.62.0,<1.70'

COPY api/ ./api/
COPY rag/ ./rag/
COPY scripts/ ./scripts/
COPY config/ ./config/
COPY data/ ./data/

# Regenerate stubs in-image so import paths match the container layout.
RUN python -m grpc_tools.protoc -I api/proto --python_out=api --grpc_python_out=api api/proto/retriever.proto \
    && sed -i 's/^import retriever_pb2/from api import retriever_pb2/' api/retriever_pb2_grpc.py \
    && chmod +x /app/api/entrypoint.sh

EXPOSE 5000 50051

CMD ["/app/api/entrypoint.sh"]
