  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types src/client.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
