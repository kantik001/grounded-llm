{
  "name": "@grounded-llm/sdk",
  "version": "0.4.0",
  "description": "TypeScript/JavaScript client for the Grounded LLM REST API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
