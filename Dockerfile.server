# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /build

# Build dependencies
RUN apk add --no-cache git

# Go module files first (better layer cache)
COPY server/go.mod server/go.sum ./
RUN go mod download

# Application source
COPY server/ .

# Refresh go.sum if new imports appeared (e.g. pgx)
RUN go mod tidy

# Static Linux binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main .

# Final runtime image
FROM alpine:3.21

RUN apk --no-cache add ca-certificates curl \
    && mkdir -p /app/data

WORKDIR /root/

# Binary from builder + SQL migrations + JSON configs
COPY --from=builder /build/main .
COPY migrations /migrations
COPY config /config

EXPOSE 8080

CMD ["./main"]
