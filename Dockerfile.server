# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /build

# Build dependencies
RUN apk add --no-cache git

# Go module files first (better layer cache)
COPY server/go.mod server/go.sum ./
RUN go mod download

# Application source
COPY server/ .

# Refresh go.sum if new imports appeared (e.g. pgx)
RUN go mod tidy

# Static Linux binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/server

# Final runtime image
FROM alpine:3.21

RUN apk --no-cache add ca-certificates curl \
    && addgroup -g 10001 app \
    && adduser -D -u 10001 -G app app \
    && mkdir -p /app/data /data/uploads \
    && chown -R app:app /app /data

WORKDIR /app

# Binary from builder + SQL migrations + JSON configs
COPY --from=builder --chown=app:app /build/main .
COPY --chown=app:app migrations /migrations
COPY --chown=app:app config /config

USER app

EXPOSE 8080

CMD ["./main"]
